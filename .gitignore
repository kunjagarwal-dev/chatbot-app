# .gitignore

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Data (large files, not tracked)
data/raw/*.txt
data/processed/*.csv
data/processed/*.pkl
data/processed/*.npy

# Models (large binary files, not tracked)
models/*
models/lstm_seq2seq/
models/gru_attention/
models/transformer_finetuned/
models/tokenizer/*.pkl

# Logs
logs/
*.log

# Environment variables
.env

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Streamlit
.streamlit/